# Copy to `.env` in the repo root (gitignored). Docker Compose reads these.
# `docker compose up --build` also works without a `.env` — compose has the same defaults.

# --- Backend (FastAPI + MongoDB) ---
# Host-only Python runs use localhost. Docker Compose overrides MONGO_URL to mongodb://mongo:27017.
MONGO_URL=mongodb://localhost:27017
DB_NAME=snp_camps
AADHAAR_HASH_PEPPER=local-dev-aadhaar-pepper-not-for-production
JWT_SECRET=local-dev-jwt-secret-not-for-production
ADMIN_EMAIL=admin@snpcamps.org
ADMIN_PASSWORD=AdminCamp@2026
# Explicit browser origins. RFC1918 LAN origins are also allowed in server.py (do not hardcode the PC IP).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTP local login cookies. Production should use COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Frontend (React) ---
# Browser origin, not the Docker service name. Loopback values are rewritten to the page hostname:8000 on LAN devices.
REACT_APP_BACKEND_URL=http://localhost:8000

# --- SMS (MSG91 DLT) ---
# Six approved DLT templates, each taking reg_no, date and venue.
# Sending is skipped entirely unless the auth key and all six template ids are set.
CRON_SECRET=local-dev-cron-secret-not-for-production
MSG91_AUTH_KEY=
MSG91_TEMPLATE_REGISTRATION=
MSG91_TEMPLATE_CAMP=
MSG91_TEMPLATE_OT_TOKEN=
MSG91_TEMPLATE_OT=
MSG91_TEMPLATE_SPECS_TOKEN=
MSG91_TEMPLATE_SPECS=

# --- Production only (docker-compose.prod.yml) ---
# A browser will not start a camera over plain HTTP, so Live scan needs a real domain.
# APP_DOMAIN=camps.example.org
# TLS_EMAIL=admin@example.org
