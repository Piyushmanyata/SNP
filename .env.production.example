APP_DOMAIN=camps.example.org
TLS_EMAIL=admin@example.org
DB_NAME=snp_camps
# 6 digits, not one digit repeated or a straight run like 123456. Used only when the database has no admin.
ADMIN_BOOTSTRAP_PIN=
MONGO_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_BACKUP_PASSWORD=
JWT_SECRET=
AADHAAR_HASH_PEPPER=
CRON_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_REGISTRATION=
MSG91_TEMPLATE_CAMP=
MSG91_TEMPLATE_OT_TOKEN=
MSG91_TEMPLATE_OT=
MSG91_TEMPLATE_SPECS_TOKEN=
MSG91_TEMPLATE_SPECS=
MSG91_TEMPLATE_OT_CHANGE=
MSG91_TEMPLATE_SPECS_CHANGE=
MSG91_WEBHOOK_SECRET=
BACKUP_INTERVAL_SECONDS=86400
# Encrypts every backup. Store a copy off the VPS: without it no backup can be restored.
RESTIC_PASSWORD=
# Optional off-host copy on S3-compatible storage (Backblaze B2, AWS S3, ...), e.g. s3:https://s3.<region>.backblazeb2.com/<bucket>/snp
RESTIC_REMOTE_REPOSITORY=
# An access key limited to that bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
